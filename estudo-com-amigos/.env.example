# Copia este ficheiro para ".env" e preenche. O ".env" NUNCA vai para o GitHub.

# Chave da API da Anthropic (a conta tem de ser de um adulto — console.anthropic.com)
ANTHROPIC_API_KEY=

# Pedidos de IA grátis por sala, por semana (perguntas, resumos, previsão de nota)
AI_WEEKLY_LIMIT=30

# Mensagens grátis ao tutor por pessoa, por dia
AI_TUTOR_DAILY=40

# Porta do servidor
PORT=3000
