# Copia este ficheiro para .env (na pasta study-ai/) e preenche os valores.
# O ficheiro .env nunca deve ir para o GitHub (já está no .gitignore).

# --- Inteligência artificial (obrigatório para o chat, resumos, flashcards e testes com IA) ---
# Chave da API da Anthropic: https://console.anthropic.com/ → API Keys
# Fica só no servidor; nunca é enviada para o navegador.
ANTHROPIC_API_KEY=

# Modelo de cada plano (opcional). Por omissão todos usam claude-opus-5-5;
# a diferença entre planos está na profundidade das respostas (esforço e tamanho).
# STUDY_AI_MODEL_CLAUDIO_5=claude-opus-5-5
# STUDY_AI_MODEL_CLAUDIO_5_5=claude-opus-5-5
# STUDY_AI_MODEL_CLAUDIO_6=claude-opus-5-5

# --- Servidor ---
PORT=8787
# Pasta da base de dados (SQLite) e dos ficheiros enviados. Em produção use um disco persistente.
# DATA_DIR=./data
# Fuso horário usado para os limites diários dos planos.
APP_TIMEZONE=Europe/Lisbon
# Cookies só por https. Por omissão: ligado em produção. Ponha false para testar em http na rede local.
# COOKIE_SECURE=true
# Atrás de um proxy (Render, Railway, Nginx…), indique quantos proxies há (normalmente 1).
# TRUST_PROXY=1

# --- Versão Netlify (IA Google Gemini, plano gratuito) ---
# Só para `npm run netlify:local`; no Netlify, defina-as em Site configuration → Environment variables.
# Chave gratuita: https://aistudio.google.com/ → Get API key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# SESSION_SECRET=um-texto-aleatorio-comprido
