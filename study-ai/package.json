{
  "name": "study-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "STUDY AI — assistente pessoal de estudos com inteligência artificial.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,white \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p cloudflare/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts --production",
    "typecheck": "tsc -p tsconfig.json && tsc -p cloudflare/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e/smoke.mjs",
    "build:artifact": "VITE_DEMO=1 vite build && node tools/build-artifact.mjs",
    "netlify:local": "node --env-file-if-exists=.env tools/netlify-local.mjs",
    "test:e2e:netlify": "TARGET=netlify node --disable-warning=ExperimentalWarning tests/e2e/smoke.mjs",
    "test:e2e:cloudflare": "TARGET=cloudflare node --disable-warning=ExperimentalWarning tests/e2e/smoke.mjs",
    "cf:local": "wrangler dev --env local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@netlify/blobs": "^11.1.6",
    "express": "^5.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@netlify/functions": "^6.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "wrangler": "^4.153.0"
  }
}
