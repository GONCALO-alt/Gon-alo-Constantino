// Configuração do Cloudflare (Workers, plano gratuito). Instruções no README:
// «Publicar grátis no Cloudflare (com a IA Gemini)». O nome do Worker tem de ser «study-ai».
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-ai",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Compila a app (dist/) antes de publicar.
  "build": { "command": "node tools/cf-build.mjs" },
  // A app: ficheiros estáticos servidos pelo Cloudflare; só /api/... passa pelo Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Dados: um Durable Object (com base de dados SQLite) por estudante.
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "StudyStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudyStore"] }],
  // As variáveis definidas no painel do Cloudflare não são apagadas ao publicar.
  "keep_vars": true,
  "observability": { "enabled": true }
}
