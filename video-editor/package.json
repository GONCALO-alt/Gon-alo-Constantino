{
  "name": "corte-studio",
  "productName": "Corte Studio",
  "version": "1.0.0",
  "description": "Editor de vídeo profissional multipista com exportação real até 4K a 60 FPS (FFmpeg).",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "test:e2e": "node tests/e2e/app.e2e.cjs && node tests/e2e/editing.e2e.cjs",
    "build:web": "node scripts/build-web.mjs"
  },
  "build": {
    "appId": "studio.corte.editor",
    "productName": "Corte Studio",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "corte",
        "name": "Projeto Corte Studio"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bowlby-one-sc": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/courgette": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/kaushan-script": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playball": "^5.3.0",
