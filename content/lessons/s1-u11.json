      "grammar": [
        {
          "id": "g-presente-regular",
          "title": "Presente regular",
          "body": "Raiz = infinitivo sem **-en**: werk(en). **ik** + raiz: ik werk. **jij, u, hij, zij, het** + raiz + **t**: jij werkt, hij werkt. **wij, jullie, zij** = infinitivo: wij werken. Na pergunta, **jij/je** depois do verbo tira o -t: *werk jij?*",
          "examples": [
            {
              "nl": "Hij maakt eten.",
              "pt": "Ele faz o jantar."
            },
            {
              "nl": "Werken jullie hier?",
              "pt": "Vocês trabalham aqui?"
            }
          ],
          "contrastWithPt": "O presente neerlandês serve também para o «estar a + infinitivo» português: ik werk = trabalho / estou a trabalhar."
        }
      ],
      "exercises": [
        {
