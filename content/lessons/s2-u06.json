      "grammar": [
        {
          "id": "g-quantidades",
          "title": "Quantidade + produto, sem «van»",
          "body": "Diz-se **een pak melk**, **een fles wijn**, **een kilo appels** — sem preposição. Medidas depois de número ficam no singular: **twee kilo**, **drie liter**. Embalagens vão ao plural: **twee flessen**, **drie pakken**. **Een pond** = 500 g.",
          "examples": [
            {
              "nl": "twee kilo aardappels",
              "pt": "dois quilos de batatas"
            },
            {
              "nl": "twee pakken melk",
              "pt": "dois pacotes de leite"
            }
          ],
          "contrastWithPt": "Em português «um pacote DE leite»; em neerlandês, «een pak melk»."
        }
