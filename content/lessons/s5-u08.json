      "grammar": [
        {
          "id": "g-meevallen-tegenvallen",
          "title": "Meevallen / tegenvallen",
          "body": "Verbos muito úteis para avaliar: **meevallen** = ser melhor do que se esperava; **tegenvallen** = ser pior do que se esperava. São separáveis e usam **zijn** no perfectum: *Het is meegevallen.* Muitas vezes com *het*: *Het valt mee!* (Não é assim tão mau!)",
          "examples": [
            {
              "nl": "Het examen viel mee.",
              "pt": "O exame foi mais fácil do que esperava."
            },
            {
              "nl": "De prijs viel tegen.",
              "pt": "O preço foi uma desilusão."
            }
          ],
          "contrastWithPt": "Não há equivalente direto em português — usamos «afinal», «não foi tão mau», «desiludiu»."
        }
      ],
