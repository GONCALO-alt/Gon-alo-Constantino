    {
      "id": "s4-u02-l002",
      "unitId": "s4-u02",
      "order": 2,
      "title": "Verbos regulares: -te e -de",
      "description": "Ik werkte, ik woonde: a regra 't kofschip.",
      "cefr": "A2-B1",
      "objectives": [
        "Formar o imperfectum dos verbos regulares"
      ],
      "newVocabulary": [
        {
          "id": "v-werkte",
          "nl": "werkte",
          "pt": [
            "trabalhava",
            "trabalhou"
          ],
          "pos": "verb",
          "note": "werken → werkte(n)"
        },
        {
          "id": "v-woonde",
          "nl": "woonde",
          "pt": [
            "morava",
            "morou"
          ],
          "pos": "verb",
          "note": "wonen → woonde(n)"
        },
        {
          "id": "v-speelde",
          "nl": "speelde",
          "pt": [
            "jogava",
            "brincava"
          ],
          "pos": "verb",
          "note": "spelen → speelde(n)"
        },
        {
          "id": "v-maakte",
          "nl": "maakte",
          "pt": [
            "fazia",
            "fez"
          ],
          "pos": "verb",
          "note": "maken → maakte(n)"
        }
      ],
      "reviewVocabulary": [
        "v-werken",
        "v-wonen",
        "v-spelen",
        "v-maken"
      ],
      "examples": [
        {
          "nl": "Ik werkte in een restaurant.",
          "pt": "Trabalhava num restaurante."
        },
        {
          "nl": "We woonden in Lissabon.",
          "pt": "Morávamos em Lisboa."
        },
        {
          "nl": "Als kind speelde ik veel buiten.",
          "pt": "Em criança brincava muito lá fora."
        },
        {
          "nl": "Hij maakte een fout.",
          "pt": "Ele fez um erro."
        }
      ],
      "grammar": [
        {
          "id": "g-imperf-regular",
          "title": "Imperfectum regular: 't kofschip",
          "body": "Junta-se ao radical **-te(n)** se ele terminar numa consoante de **'t kofschip** (t, k, f, s, ch, p): *werk → werkte*, *maak → maakte*. Nos outros casos, **-de(n)**: *woon → woonde*, *speel → speelde*. Plural: **-ten/-den**.",
          "examples": [
            {
              "nl": "Ik fietste naar school.",
              "pt": "Ia de bicicleta para a escola."
            },
            {
              "nl": "Zij woonden in Gent.",
              "pt": "Eles moravam em Gante."
            }
          ],
          "contrastWithPt": "É a mesma regra que decide -t/-d no particípio (gewerkt, gewoond)."
        }
      ],
      "exercises": [
