      "order": 1,
      "title": "Was e had: o passado de zijn e hebben",
      "description": "Ik was moe. We hadden geen tijd.",
      "cefr": "A2-B1",
      "objectives": [
        "Usar o imperfectum de zijn e hebben"
      ],
      "newVocabulary": [
        {
          "id": "v-was",
          "nl": "was",
          "pt": [
            "era",
            "estava"
          ],
          "pos": "verb",
          "note": "zijn → ik/jij/hij was, wij/jullie/zij waren"
        },
        {
          "id": "v-waren",
          "nl": "waren",
          "pt": [
            "éramos",
            "estavam"
          ],
          "pos": "verb"
        },
        {
          "id": "v-had",
          "nl": "had",
          "pt": [
            "tinha"
          ],
          "pos": "verb",
          "note": "hebben → ik/jij/hij had, wij/jullie/zij hadden"
        },
        {
          "id": "v-hadden",
          "nl": "hadden",
          "pt": [
            "tínhamos",
            "tinham"
          ],
          "pos": "verb"
        }
      ],
      "reviewVocabulary": [
        "v-zijn",
        "v-hebben",
        "v-moe",
        "v-gisteren"
      ],
      "examples": [
        {
          "nl": "Ik was gisteren erg moe.",
          "pt": "Ontem estava muito cansado."
        },
        {
          "nl": "We waren in Den Haag.",
          "pt": "Estávamos na Haia."
        },
        {
          "nl": "Ik had geen tijd.",
          "pt": "Não tinha tempo."
        },
        {
          "nl": "Ze hadden een hond.",
          "pt": "Eles tinham um cão."
        }
      ],
      "grammar": [
        {
          "id": "g-imperf-zijn-hebben",
          "title": "Imperfectum de zijn e hebben",
          "body": "São irregulares. **zijn**: ik/jij/u/hij/zij **was** — wij/jullie/zij **waren**. **hebben**: ik/jij/u/hij/zij **had** — wij/jullie/zij **hadden**. No imperfectum, o singular tem uma só forma; o plural junta **-en**.",
          "examples": [
            {
              "nl": "Het was koud.",
              "pt": "Estava frio."
            },
            {
              "nl": "Hadden jullie honger?",
              "pt": "Vocês tinham fome?"
            }
          ],
          "contrastWithPt": "O imperfectum corresponde muitas vezes ao nosso pretérito imperfeito («era», «tinha») em descrições."
        }
      ],
