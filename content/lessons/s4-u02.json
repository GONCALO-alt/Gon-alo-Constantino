      "grammar": [
        {
          "id": "g-perf-vs-imperf",
          "title": "Perfectum vs. imperfectum",
          "body": "Na conversa, para **um facto** passado (resultado, novidade), usa-se sobretudo o **perfectum**: *Ik heb mijn telefoon verloren.* Para **descrever**, **hábitos** (*vroeger, elke zomer*) e para **contar uma história** em sequência, usa-se muito o **imperfectum**: *Vroeger woonde ik in Faro.* Muitas histórias começam no perfectum e continuam no imperfectum.",
          "examples": [
            {
              "nl": "Ik ben naar Gent geweest. Het was erg gezellig.",
              "pt": "Estive em Gante. Foi muito agradável."
            },
            {
              "nl": "Vroeger speelden we elke dag buiten.",
              "pt": "Antigamente brincávamos lá fora todos os dias."
            }
          ],
          "contrastWithPt": "O imperfectum aproxima-se do nosso imperfeito (hábitos, descrições)."
        }
      ],
