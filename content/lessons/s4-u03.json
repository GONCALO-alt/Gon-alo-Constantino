      "id": "s4-u03-l003",
      "unitId": "s4-u03",
      "order": 3,
      "title": "O presente com sentido de futuro",
      "description": "Morgen werk ik thuis. Volgende week ben ik vrij.",
      "cefr": "A2-B1",
      "objectives": [
        "Usar o presente com uma indicação de tempo para falar do futuro"
      ],
      "newVocabulary": [
        {
          "id": "v-volgende-week",
          "nl": "volgende week",
          "pt": [
            "na próxima semana"
          ],
          "pos": "expression"
        },
        {
          "id": "v-over-twee-weken",
          "nl": "over twee weken",
          "pt": [
            "daqui a duas semanas"
          ],
          "pos": "expression"
        },
        {
          "id": "v-vanmiddag",
          "nl": "vanmiddag",
          "pt": [
            "esta tarde"
          ],
          "pos": "adverb"
        },
        {
          "id": "v-dit-weekend",
          "nl": "dit weekend",
          "pt": [
            "este fim de semana"
          ],
          "pos": "expression"
        }
      ],
      "reviewVocabulary": [
        "v-morgen",
        "v-thuiswerken",
        "v-vrij",
        "v-afspraak"
      ],
      "examples": [
        {
          "nl": "Morgen werk ik thuis.",
          "pt": "Amanhã trabalho em casa."
        },
        {
          "nl": "Volgende week ben ik vrij.",
          "pt": "Na próxima semana estou de folga."
        },
        {
          "nl": "Over twee weken vertrek ik.",
          "pt": "Parto daqui a duas semanas."
        },
        {
          "nl": "Vanmiddag heb ik een afspraak.",
          "pt": "Esta tarde tenho uma marcação."
        }
      ],
      "grammar": [
        {
          "id": "g-presente-futuro",
          "title": "Presente = futuro",
          "body": "Em neerlandês, se a frase tiver uma indicação de tempo futuro (*morgen, volgende week, over twee weken*), o **presente** basta: *Morgen werk ik thuis.* **over** + período = daqui a: *over een uur* (daqui a uma hora).",
          "examples": [
            {
              "nl": "Ik bel je over een uur.",
              "pt": "Ligo-te daqui a uma hora."
            },
            {
              "nl": "Dit weekend blijf ik thuis.",
              "pt": "Este fim de semana fico em casa."
            }
          ],
          "contrastWithPt": "Tal como em português («amanhã trabalho em casa»). Atenção: «over» com tempo = daqui a, não «sobre»."
        }
      ],
