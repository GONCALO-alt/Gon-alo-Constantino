            "com certeza"
          ],
          "pos": "adverb"
        },
        {
          "id": "v-zullen-we",
          "nl": "zullen we…?",
          "pt": [
            "e se…? (proposta)"
          ],
          "pos": "expression",
          "note": "Zullen we gaan? = Vamos?"
        }
      ],
      "reviewVocabulary": [
        "v-helpen",
        "v-zou",
        "v-bellen"
      ],
      "examples": [
        {
          "nl": "Ik zal je helpen.",
          "pt": "Eu ajudo-te. / Hei de ajudar-te."
        },
        {
          "nl": "Ik beloof het.",
          "pt": "Prometo."
        },
        {
          "nl": "Het zal zeker lukken.",
          "pt": "Vai certamente correr bem."
        },
        {
          "nl": "Zullen we een kopje koffie drinken?",
          "pt": "Vamos tomar um café?"
        }
      ],
      "grammar": [
        {
          "id": "g-zullen",
          "title": "Zullen",
          "body": "**zullen** + infinitivo no fim exprime **promessa** (*Ik zal het doen*), **previsão** mais formal (*Het zal morgen regenen*) e, com *we*, uma **proposta**: *Zullen we gaan?* (Vamos?). No dia a dia, para planos, prefere-se *gaan* ou o presente.",
          "examples": [
            {
              "nl": "Ik zal je morgen bellen.",
              "pt": "Ligo-te amanhã (prometo)."
            },
            {
              "nl": "Zullen we morgen afspreken?",
              "pt": "Combinamos para amanhã?"
            }
          ],
          "contrastWithPt": "«Zullen we…?» funciona como o nosso «Vamos…?» ou «E se…?»."
        }
      ],
