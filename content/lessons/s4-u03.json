      "title": "Zullen: promessas e previsões",
      "description": "Ik zal je helpen. Dat zal wel goed komen.",
      "cefr": "A2-B1",
      "objectives": [
        "Usar zullen para promessas, previsões e propostas"
      ],
      "newVocabulary": [
        {
          "id": "v-zullen",
          "nl": "zullen",
          "pt": [
            "(futuro) -ei / irá"
          ],
          "pos": "verb",
          "note": "ik zal, jij zult/zal, hij zal, wij zullen"
        },
