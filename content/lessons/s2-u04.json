      "grammar": [
        {
          "id": "g-graag",
          "title": "Graag para gostos",
          "body": "A forma mais natural de dizer que se gosta de fazer algo é **verbo + graag**: *ik eet **graag** vis* (gosto de comer peixe). Negativo: *ik eet **niet graag** vis*. **houden van** é mais forte (adorar, amar): *ik houd van kaas*. Para comida também se usa **lusten**: *ik lust geen spruitjes*.",
          "examples": [
            {
              "nl": "Ik fiets graag.",
              "pt": "Gosto de andar de bicicleta."
            }
          ],
          "contrastWithPt": "O português usa um verbo («gostar»); o neerlandês prefere um advérbio junto do verbo principal."
        }
      ],
