                },
                {
                  "id": "b",
                  "text": "É mais rápida",
                  "correct": false
                },
                {
                  "id": "c",
                  "text": "É mais segura",
                  "correct": false
                }
              ]
            },
            {
              "prompt": "Porque não são as câmaras totalmente positivas?",
              "options": [
                {
                  "id": "a",
                  "text": "As bicicletas são mal estacionadas e bloqueiam passeios",
                  "correct": true
                },
                {
                  "id": "b",
                  "text": "São caras para a câmara",
                  "correct": false
                },
                {
                  "id": "c",
                  "text": "Poluem",
                  "correct": false
                }
              ]
            },
            {
              "prompt": "De que depende o futuro das bicicletas partilhadas, segundo os especialistas?",
