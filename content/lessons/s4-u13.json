            "apenas"
          ],
          "pos": "expression"
        },
        {
          "id": "v-geen-hoeven",
          "nl": "geen … hoeven",
          "pt": [
            "não precisar de (nome)"
          ],
          "pos": "expression",
          "note": "Je hoeft geen jas mee te nemen."
        }
      ],
      "reviewVocabulary": [
        "v-moeten",
        "v-niet",
        "v-geen"
      ],
      "examples": [
        {
          "nl": "Je hoeft niet te komen.",
          "pt": "Não precisas de vir."
        },
        {
          "nl": "Dat hoeft niet, hoor.",
          "pt": "Não é preciso, a sério."
        },
        {
          "nl": "Je hoeft alleen maar te tekenen.",
          "pt": "Só tens de assinar."
        },
        {
          "nl": "Je hoeft geen paraplu mee te nemen.",
          "pt": "Não precisas de levar guarda-chuva."
        }
      ],
      "grammar": [
        {
          "id": "g-hoeven",
          "title": "Niet hoeven te",
          "body": "A negação de **moeten** é **niet hoeven te** + infinitivo: *Je **moet** komen* → *Je **hoeft niet te** komen.* (não *moet niet*, que significa «não deves»!). **hoeven** só aparece com negação ou com **alleen (maar)**: *Je hoeft alleen maar te tekenen.*",
          "examples": [
            {
              "nl": "Je moet niet roken.",
              "pt": "Não deves fumar. (proibição/conselho)"
            },
            {
              "nl": "Je hoeft niet te roken.",
              "pt": "Não tens de fumar. (sem obrigação)"
            }
          ],
          "contrastWithPt": "É como a diferença entre «não deves» e «não precisas»."
        }
      ],
