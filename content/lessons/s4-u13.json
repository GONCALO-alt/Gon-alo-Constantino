      "grammar": [
        {
          "id": "g-modaal-basis",
          "title": "Verbos modais: estrutura",
          "body": "O modal conjuga-se na **2.ª posição**; o outro verbo vai **no infinitivo, no fim**: *Ik **kan** morgen niet **komen**.* **kunnen**: ik kan, jij kunt/kan, hij kan, wij kunnen. **willen**: ik wil, jij wilt/wil, hij wil, wij willen. Com **inversão**, *jij* perde o -t: *Kun je…? Wil je…?*",
          "examples": [
            {
              "nl": "Kunnen jullie mij helpen?",
              "pt": "Podem ajudar-me?"
            },
            {
              "nl": "Wil je mee?",
              "pt": "Queres vir?"
            }
          ],
          "contrastWithPt": "Em português o infinitivo segue o modal («posso vir»); em neerlandês vai para o fim da frase."
        }
      ],
