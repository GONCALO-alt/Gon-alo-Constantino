      "grammar": [
        {
          "id": "g-perfeito-zijn",
          "title": "Zijn + particípio",
          "body": "Usam **zijn** os verbos de **mudança de lugar** com destino (*gaan, komen, vertrekken*) e de **mudança de estado** (*worden, sterven*), além de **zijn** e **blijven**: *ik **ben** gegaan*, *hij **is** gekomen*, *we **zijn** gebleven*. A maioria dos outros verbos usa **hebben**.",
          "examples": [
            {
              "nl": "Ik ben ziek geworden.",
              "pt": "Fiquei doente."
            },
            {
              "nl": "Ik ben nooit in Japan geweest.",
              "pt": "Nunca estive no Japão."
            }
          ],
          "contrastWithPt": "Parecido com o francês «je suis allé»; em português usa-se sempre «ter»."
        }
      ],
