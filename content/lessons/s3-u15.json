      "grammar": [
        {
          "id": "g-perfeito",
          "title": "O perfeito (voltooid tegenwoordige tijd)",
          "body": "Para falar do passado na conversa usa-se sobretudo o **perfeito**: **hebben** (conjugado, 2.ª posição) + **particípio** (no fim). Particípio regular: **ge + raiz + t/d**: werken → **gewerkt**, maken → **gemaakt**, wonen → **gewoond**. Leva **-t** se a raiz acaba em t, k, f, s, ch, p ('t kofschip); senão **-d**.",
          "examples": [
            {
              "nl": "Ik heb Nederlands geleerd.",
              "pt": "Aprendi neerlandês."
            },
            {
              "nl": "Hij heeft lang gewacht.",
              "pt": "Ele esperou muito tempo."
            }
          ],
          "contrastWithPt": "Em português dizemos «trabalhei» (pretérito perfeito simples); o neerlandês prefere a forma composta «ik heb gewerkt» na fala."
        }
      ],
