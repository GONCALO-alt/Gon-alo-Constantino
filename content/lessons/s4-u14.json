      "examples": [
        {
          "nl": "Ik weet dat je moe bent.",
          "pt": "Sei que estás cansado."
        },
        {
          "nl": "Hij zegt dat hij later komt.",
          "pt": "Ele diz que vem mais tarde."
        },
        {
          "nl": "Weet je zeker dat de winkel open is?",
          "pt": "Tens a certeza de que a loja está aberta?"
        },
