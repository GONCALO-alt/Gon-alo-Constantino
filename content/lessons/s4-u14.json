      "order": 1,
      "title": "Dat: o verbo vai para o fim",
      "description": "Ik weet dat… Hij zegt dat…",
      "cefr": "A2-B1",
      "objectives": [
        "Formar orações com dat e o verbo no fim"
      ],
      "newVocabulary": [
        {
          "id": "v-dat-conj",
          "nl": "dat (conj.)",
