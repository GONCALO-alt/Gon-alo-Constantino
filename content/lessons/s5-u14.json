      "grammar": [
        {
          "id": "g-plusquamperfectum",
          "title": "Plusquamperfectum",
          "body": "**had/hadden** ou **was/waren** + particípio: ação **anterior** a outra no passado. O auxiliar segue a mesma regra do perfectum (zijn para movimento/mudança de estado): *De trein **was** al **vertrokken**.* *Ik **had** al **gegeten**.*",
          "examples": [
            {
              "nl": "Hij was al naar huis gegaan.",
              "pt": "Ele já tinha ido para casa."
            }
          ],
          "contrastWithPt": "Corresponde ao nosso «tinha + particípio»."
        }
      ],
