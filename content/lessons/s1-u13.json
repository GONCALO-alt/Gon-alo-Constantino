      "grammar": [
        {
          "id": "g-perguntas-sim-nao",
          "title": "Perguntas de sim/não",
          "body": "O **verbo vai para o início** e o sujeito vem a seguir: *Jij werkt hier* → ***Werk jij** hier?* (o -t cai com jij/je). A entoação sobe no fim, como em português.",
          "examples": [
            {
              "nl": "Is hij thuis?",
              "pt": "Ele está em casa?"
            },
            {
              "nl": "Spreekt u Engels?",
              "pt": "Fala inglês?"
            }
          ],
          "contrastWithPt": "Em português basta mudar a entoação («Trabalhas aqui?»); em neerlandês também se muda a ordem."
        }
      ],
