      "grammar": [
        {
          "id": "g-interrogativas",
          "title": "Palavras interrogativas",
          "body": "Com palavra interrogativa, ela ocupa a 1.ª posição e o **verbo vem logo a seguir**: *Waar **woon** je?*, *Wanneer **kom** je?*. **welk** + palavra het (*welk huis*), **welke** + palavra de ou plural (*welke trein*, *welke boeken*).",
          "examples": [
            {
              "nl": "Wat drink je?",
              "pt": "O que bebes?"
            },
            {
              "nl": "Wie heeft mijn pen?",
              "pt": "Quem tem a minha caneta?"
            }
          ]
        }
