      "id": "s1-u10-l001",
      "unitId": "s1-u10",
      "order": 1,
      "title": "De ou het?",
      "description": "Os dois artigos definidos e porque não seguem o género português.",
      "cefr": "A1",
      "objectives": [
        "Saber que «de» é o artigo mais comum",
        "Memorizar cada substantivo com o seu artigo"
      ],
      "newVocabulary": [
        {
          "id": "v-de",
          "nl": "de",
          "pt": [
            "o",
            "a",
            "os",
            "as"
          ],
          "pos": "article",
          "note": "Artigo de cerca de 2/3 dos substantivos e de todos os plurais."
        },
        {
          "id": "v-het",
          "nl": "het",
          "pt": [
            "o",
            "a"
          ],
          "pos": "article",
          "note": "Artigo «neutro»: só no singular."
