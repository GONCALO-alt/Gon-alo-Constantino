        {
          "nl": "het huis, het meisje",
          "pt": "a casa, a rapariga"
        },
        {
          "nl": "de huizen, de meisjes",
          "pt": "as casas, as raparigas",
          "note": "Plural: sempre «de»."
        }
      ],
      "grammar": [
        {
          "id": "g-de-het",
          "title": "De e het",
          "body": "O neerlandês tem dois artigos definidos: **de** (cerca de dois terços das palavras) e **het**. **Não** correspondem ao masculino/feminino português: *het meisje* (a rapariga) usa het. No **plural, sempre de**. A melhor estratégia é aprender cada palavra com o artigo: não «huis», mas «het huis».",
          "examples": [
            {
              "nl": "de auto",
              "pt": "o carro"
            },
            {
              "nl": "het meisje",
              "pt": "a rapariga"
            }
          ],
          "contrastWithPt": "Não tente deduzir o artigo pelo género em português: «a casa» é het huis e «o carro» é de auto."
        }
      ],
      "exercises": [
        {
          "id": "s1-u10-l001-e01",
          "type": "multipleChoice",
          "instruction": "Escolha a resposta certa.",
          "explanation": "Plural → de.",
