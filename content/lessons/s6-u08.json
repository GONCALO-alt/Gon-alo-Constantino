      "unitId": "s6-u08",
      "order": 1,
      "title": "Kennen vs. weten; leren vs. studeren",
      "description": "Verbos fáceis de confundir.",
      "cefr": "B1-B2",
      "objectives": [
        "Distinguir pares de verbos frequentemente confundidos"
      ],
      "newVocabulary": [
        {
          "id": "v-kennen-weten",
          "nl": "kennen / weten",
          "pt": [
            "conhecer / saber"
          ],
          "pos": "expression"
        },
        {
          "id": "v-leren-studeren",
          "nl": "leren / studeren",
          "pt": [
            "aprender / estudar (curso)"
          ],
          "pos": "expression"
        },
        {
          "id": "v-lenen-uitlenen",
          "nl": "lenen / uitlenen",
          "pt": [
            "pedir emprestado / emprestar"
          ],
          "pos": "expression"
        },
        {
          "id": "v-zetten-leggen",
          "nl": "zetten / leggen",
          "pt": [
            "pôr (de pé) / pôr (deitado)"
          ],
          "pos": "expression"
        }
      ],
      "reviewVocabulary": [
        "v-kennen",
        "v-weten",
        "v-leren",
        "v-studeren",
        "v-lenen"
      ],
      "examples": [
        {
          "nl": "Ik ken hem, maar ik weet zijn naam niet.",
          "pt": "Conheço-o, mas não sei o nome dele."
        },
        {
          "nl": "Ze studeert rechten en leert Spaans.",
          "pt": "Ela estuda Direito e está a aprender espanhol."
        },
        {
          "nl": "Mag ik je fiets lenen?",
          "pt": "Posso pedir-te a bicicleta emprestada?"
        },
        {
          "nl": "Zet de fles op tafel en leg het boek ernaast.",
          "pt": "Põe a garrafa na mesa e pousa o livro ao lado."
        }
      ],
      "grammar": [
        {
          "id": "g-verwarrende-paren",
          "title": "Pares confusos",
          "body": "**kennen** + pessoa/lugar/coisa (conhecer); **weten** + facto/oração (saber): *Ik weet dat…* **studeren** = estudar um curso; **leren** = aprender/estudar para algo: *Ik leer voor mijn toets.* **lenen** = pedir emprestado; **uitlenen** = emprestar. **zetten** (pôr de pé) / **leggen** (pôr deitado).",
          "examples": [
            {
              "nl": "Weet jij waar het station is?",
              "pt": "Sabes onde fica a estação?"
            },
            {
              "nl": "Ken je Utrecht?",
              "pt": "Conheces Utrecht?"
            }
          ],
          "contrastWithPt": "Em português «emprestar» e «pedir emprestado» são diferentes; em neerlandês também, mas muitos aprendentes trocam."
        }
      ],
      "exercises": [
