      "unitId": "s2-u09",
      "order": 1,
      "title": "O adjetivo antes do nome: -e",
      "description": "de grote stad, een grote stad, grote steden.",
      "cefr": "A1-A2",
      "objectives": [
        "Pôr o -e no adjetivo antes do nome"
      ],
      "newVocabulary": [
        {
          "id": "v-nieuw",
          "nl": "nieuw",
          "pt": [
            "novo"
          ],
          "pos": "adjective"
        },
        {
