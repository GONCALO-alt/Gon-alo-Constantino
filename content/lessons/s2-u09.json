          "pt": [
            "cheio"
          ],
          "pos": "adjective"
        }
      ],
      "reviewVocabulary": [
        "v-groot",
        "v-klein",
        "v-oud",
        "v-fiets",
        "v-stad"
      ],
      "examples": [
