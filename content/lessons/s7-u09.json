      ],
      "grammar": [
        {
          "id": "g-tijden-overzicht",
          "title": "Os tempos",
          "body": "**ott** (presente): ik werk. **ovt** (imperfectum): ik werkte. **vtt** (perfectum): ik heb gewerkt. **vvt** (plusquamperfectum): ik had gewerkt. **ottt** (futuro): ik zal werken. **vttt**: ik zal hebben gewerkt. **ovtt** (condicional): ik zou werken. **vvtt**: ik zou hebben gewerkt. Na prática, os mais usados são ott, vtt, ovt e zou.",
          "examples": [
            {
              "nl": "Als ik tijd had gehad, zou ik je hebben geholpen.",
              "pt": "Se tivesse tido tempo, ter-te-ia ajudado."
            }
          ]
        }
