      "examples": [
        {
          "nl": "Welk lidwoord hoort bij «huis»?",
          "pt": "Que artigo vai com «huis»?"
        },
        {
          "nl": "Verkleinwoorden zijn altijd het-woorden.",
          "pt": "Os diminutivos são sempre palavras com het."
        },
        {
          "nl": "Na «een» buig je het adjectief niet bij het-woorden.",
          "pt": "Depois de «een» não se flexiona o adjetivo com palavras het."
        },
        {
          "nl": "«Het» is het onzijdige lidwoord.",
          "pt": "«Het» é o artigo neutro."
        }
      ],
      "grammar": [
        {
          "id": "g-dehet-overzicht",
          "title": "Regras úteis",
          "body": "**het**: diminutivos (-je), infinitivos como nome (*het eten*), muitas palavras com *ge-/be-/ver-* + -sel/-te (*het gebouw*), línguas, metais. **de**: plural de tudo, pessoas, -ing, -heid, -tie, -teit. **Adjetivo**: leva **-e**, exceto **een/geen/geen artigo + het-woord singular**: *een groot huis*, mas *het grote huis*.",
          "examples": [
            {
              "nl": "een mooi huisje / het mooie huisje / mooie huisjes",
              "pt": "uma casinha bonita / a casinha bonita / casinhas bonitas"
            }
          ]
        }
      ],
