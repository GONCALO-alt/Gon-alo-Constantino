        "v-toch"
      ],
      "examples": [
        {
          "nl": "Het regent, dus neem ik de bus.",
          "pt": "Está a chover, portanto apanho o autocarro."
        },
        {
          "nl": "Het was duur, toch heb ik het gekocht.",
          "pt": "Era caro; mesmo assim comprei-o."
        },
        {
          "nl": "Het huis is groot. Bovendien is het goedkoop.",
          "pt": "A casa é grande. Além disso é barata."
        },
        {
          "nl": "Schiet op, anders missen we de trein!",
          "pt": "Despacha-te, senão perdemos o comboio!"
        }
      ],
      "grammar": [
        {
          "id": "g-bijwoord-inversie",
          "title": "Advérbios de ligação = inversão",
          "body": "**daarom, toch, bovendien, anders, daarna, dus** são advérbios: ocupam a 1.ª posição e provocam **inversão**: *…, toch **heb ik** het gekocht.* **dus** admite as duas ordens no uso real: *dus ik neem* (falado) / *dus neem ik* (mais cuidado).",
          "examples": [
            {
              "nl": "Ik was ziek. Daarom ben ik niet gekomen.",
              "pt": "Estava doente. Por isso não vim."
            }
          ],
          "contrastWithPt": "Em português «por isso eu fui» e «por isso fui» são iguais; em neerlandês o verbo tem de vir logo a seguir."
        }
      ],
