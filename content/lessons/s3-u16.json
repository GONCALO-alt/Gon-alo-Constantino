      "grammar": [
        {
          "id": "g-zou",
          "title": "Zou = condicional de cortesia",
          "body": "**zou** (de *zullen*) + infinitivo no fim torna os pedidos muito educados: **Zou u … kunnen?** (poderia…?), **Zou ik … mogen?** (poderia eu…?). Com *jij*: **Zou je…?** É mais formal do que *Kun je…?*",
          "examples": [
            {
              "nl": "Zou je de deur dicht willen doen?",
              "pt": "Importavas-te de fechar a porta?"
            }
          ],
          "contrastWithPt": "Equivale ao nosso condicional de cortesia: «poderia», «importava-se de»."
        }
