      "grammar": [
        {
          "id": "g-v2",
          "title": "Verbo em 2.º lugar (V2)",
          "body": "Numa frase declarativa, o **verbo conjugado ocupa sempre a 2.ª posição**. A 1.ª posição pode ser o sujeito ou outro elemento. Advérbios como **vaak, soms, altijd, nooit** vêm normalmente **depois** do verbo: *ik drink **vaak** koffie*.",
          "examples": [
            {
              "nl": "Ik werk altijd thuis.",
              "pt": "Trabalho sempre em casa."
            }
          ],
          "contrastWithPt": "Em português dizemos «eu sempre trabalho» ou «trabalho sempre»; em neerlandês só a segunda ordem: «ik werk altijd»."
        }
      ],
