      "grammar": [
        {
          "id": "g-inversao",
          "title": "Inversão",
          "body": "Se a frase **não começa pelo sujeito**, o sujeito passa para **depois do verbo**: *Ik werk vandaag* → ***Vandaag werk ik***. O verbo nunca sai da 2.ª posição. Com **jij/je** depois do verbo, o -t cai: *Morgen werk je thuis*.",
          "examples": [
            {
              "nl": "Nu ga ik.",
              "pt": "Agora vou."
            },
            {
              "nl": "Daarna eet hij.",
              "pt": "A seguir ele come."
            }
          ],
          "contrastWithPt": "Em português «Hoje eu trabalho» é normal; em neerlandês «Vandaag ik werk» está errado."
        }
      ],
